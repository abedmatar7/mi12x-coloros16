#!/sbin/sh
#################
# Initialization
#################
umask 022

ui_print() { echo "ui_print $1" > /proc/self/fd/$OUTFD; echo "ui_print" > /proc/self/fd/$OUTFD; }

OUTFD=$2
ZIPFILE=$3

mount /data 2>/dev/null

[ -f /data/adb/magisk/util_functions.sh ] || {
  ui_print "! Unable to extract Magisk util_functions.sh!"
  exit 1
}

. /data/adb/magisk/util_functions.sh

install_module
exit 0
